{
  "format": "electric3d",
  "version": 3,
  "name": "C++ controller and MOSFET test",
  "board": {"width": 20, "height": 16},
  "controller_code": "extern \"C\" __declspec(dllexport)\nvoid controller_tick(const int* input, int* output, double seconds) {\n    (void)input;\n    output[0] = int(seconds * 2) % 2 == 0;\n    output[1] = 0;\n    output[2] = 0;\n    output[3] = 0;\n}\n",
